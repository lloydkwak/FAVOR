+name: libero_alphabet_soup_image_joint
+
+shape_meta: &shape_meta
+  # acceptable types: rgb, low_dim
+  obs:
+    agentview_image:
+      shape: [3, 84, 84]
+      type: rgb
+    robot0_eye_in_hand_image:
+      shape: [3, 84, 84]
+      type: rgb
+    robot0_eef_pos:
+      shape: [3]
+      # type default: low_dim
+    robot0_eef_quat:
+      shape: [4]
+    robot0_gripper_qpos:
+      shape: [2]
+  action: 
+    shape: [8]  # joint_pos(7) + gripper(1) -- NOT pos(3)+rot6d(6)+gripper(1)
+
+task_name: &task_name libero_alphabet_soup
+dataset_type: &dataset_type ph
+# Absolute: train.py runs with cwd=/workspace/diffusion_policy, so the
+# original relative path resolved to /workspace/diffusion_policy/data,
+# while the converted LIBERO datasets live at /workspace/data. Matches
+# the absolute path env_runner already uses.
+dataset_path: &dataset_path /workspace/data/robomimic/datasets/${task.task_name}/${task.dataset_type}/image_abs.hdf5
+abs_action: &abs_action True  # kept True: env_runner still needs abs_action semantics for actuation_mode='joint' wiring
+
+env_runner:
+  # Real runner, restored now that the LIBERO evaluation path works
+  # (env registration + bddl path repair via libero_env_adapter). This
+  # produces genuine test_mean_score during training, so checkpoint.topk
+  # can select on task success exactly as the robosuite lift/can/square
+  # checkpoints were selected. fault_type=null keeps in-training rollouts
+  # fault-free; the fault sweep sets it per condition at eval time.
+  _target_: favor_fault_runner.FaultRobomimicImageRunner
+  dataset_path: /workspace/data/robomimic/datasets/libero_alphabet_soup/ph/image_abs.hdf5
+  shape_meta: *shape_meta
+  fault_joint_name: robot0_joint1
+  fault_type: null
+  fault_severity: null
+  n_train: 0
+  n_test: 50
+  test_start_seed: 10000
+  n_envs: 5
+  max_steps: 400
+  n_obs_steps: ${n_obs_steps}
+  n_action_steps: ${n_action_steps}
+  render_obs_key: 'agentview_image'
+  abs_action: *abs_action
+  actuation_mode: 'joint'
+
+dataset:
+  _target_: diffusion_policy.dataset.robomimic_replay_joint_action_dataset.RobomimicReplayJointActionDataset
+  shape_meta: *shape_meta
+  dataset_path: *dataset_path
+  horizon: ${horizon}
+  pad_before: ${eval:'${n_obs_steps}-1+${n_latency_steps}'}
+  pad_after: ${eval:'${n_action_steps}-1'}
+  n_obs_steps: ${dataset_obs_steps}
+  use_cache: True
+  seed: 42
+  val_ratio: 0.02
