diff --git a/diffusion_policy/config/checkpoint/joint_topk.yaml b/diffusion_policy/config/checkpoint/joint_topk.yaml
new file mode 100644
index 0000000..090deff
--- /dev/null
+++ b/diffusion_policy/config/checkpoint/joint_topk.yaml
@@ -0,0 +1,10 @@
+# Matches official checkpoint.topk semantics exactly (monitor_key=test_mean_score,
+# mode=max, k=5, official format_str) -- now valid because env_runner produces
+# real test_mean_score via FaultRobomimicImageRunner instead of NullEnvRunner.
+topk:
+  monitor_key: test_mean_score
+  mode: max
+  k: 5
+  format_str: 'epoch={epoch:04d}-test_mean_score={test_mean_score:.3f}.ckpt'
+save_last_ckpt: True
+save_last_snapshot: False
diff --git a/diffusion_policy/config/checkpoint/joint_trainloss_topk.yaml b/diffusion_policy/config/checkpoint/joint_trainloss_topk.yaml
new file mode 100644
index 0000000..6623fef
--- /dev/null
+++ b/diffusion_policy/config/checkpoint/joint_trainloss_topk.yaml
@@ -0,0 +1,20 @@
+# Training-only checkpoint policy, for runs that use NullEnvRunner.
+#
+# joint_topk.yaml selects on test_mean_score, which only exists when a real
+# env_runner produces rollouts. LIBERO training currently runs with
+# NullEnvRunner (the libero package is not installed in this image, so
+# FaultRobomimicImageRunner cannot construct Libero_Floor_Manipulation), so
+# that key is never logged and topk selection would silently never fire.
+#
+# Selecting on train_loss instead keeps checkpointing meaningful during the
+# training-only phase. It is NOT a substitute for success-rate-based
+# selection: once the evaluation path is wired up, re-run with joint_topk
+# so checkpoints are chosen by actual task success, matching how the
+# robosuite lift/can/square checkpoints were selected.
+topk:
+  monitor_key: train_loss
+  mode: min
+  k: 5
+  format_str: 'epoch={epoch:04d}-train_loss={train_loss:.4f}.ckpt'
+save_last_ckpt: True
+save_last_snapshot: False
