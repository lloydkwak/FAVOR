diff --git a/diffusion_policy/dataset/robomimic_replay_joint_action_dataset.py b/diffusion_policy/dataset/robomimic_replay_joint_action_dataset.py
index 2197527..9e9686e 100644
--- a/diffusion_policy/dataset/robomimic_replay_joint_action_dataset.py
+++ b/diffusion_policy/dataset/robomimic_replay_joint_action_dataset.py
@@ -225,7 +225,26 @@ def _convert_robomimic_to_replay_joint(store, shape_meta, dataset_path,
                 for i in range(len(demos)):
                     demo = demos[f'demo_{i}']
                     this_joint.append(demo['obs']['robot0_joint_pos'][:].astype(np.float32))
-                    this_gripper.append(demo['actions'][:, 6:7].astype(np.float32))
+                    # Gripper is index 7, not 6: this action layout is
+                    # joint_pos(7, indices 0..6) + gripper(1, index 7), as
+                    # produced by both the robosuite lift/can/square joint
+                    # configs and convert_libero_to_robomimic.py. Reading
+                    # index 6 instead duplicated the last joint value into
+                    # the gripper channel -- confirmed directly: the cached
+                    # zarr's action[:,6] and action[:,7] were bitwise
+                    # identical, while the source hdf5's demo_0/actions[:,6]
+                    # (a continuous joint angle) and [:,7] (a clean {-1,+1}
+                    # binary gripper command, verified across all 50 demos)
+                    # were not. The resulting normalizer fit a continuous
+                    # range (roughly [-0.52, 2.00]) onto what should have
+                    # been a binary channel, and a policy trained against
+                    # that never learned to command the gripper at all
+                    # (predicted ~0.75 regardless of context, vs. ground
+                    # truth -1.0) -- the root cause of a fully-trained
+                    # policy (loss ~1e-4, joint predictions matching demos
+                    # to within 0.001 rad) still scoring exactly 0 success
+                    # even when evaluated at the demo's own recorded states.
+                    this_gripper.append(demo['actions'][:, 7:8].astype(np.float32))
                 this_joint = np.concatenate(this_joint, axis=0)
                 this_gripper = np.concatenate(this_gripper, axis=0)
                 this_data = np.concatenate([this_joint, this_gripper], axis=-1)
diff --git a/diffusion_policy/gym_util/async_vector_env.py b/diffusion_policy/gym_util/async_vector_env.py
index dfb0f62..43b0cfa 100644
--- a/diffusion_policy/gym_util/async_vector_env.py
+++ b/diffusion_policy/gym_util/async_vector_env.py
@@ -33,6 +33,27 @@ from gym.vector.utils import (
 __all__ = ["AsyncVectorEnv"]
 
 
+# gym 0.22+ reordered concatenate()'s arguments from (items, out, space) to
+# (space, items, out). This file is vendored against gym 0.21 and calls it
+# in the old order at two call sites below. Version is detected from the
+# live function signature (not a hardcoded gym.__version__ check) so both
+# of this project's images work from the same source: favor-p0 pins
+# gym==0.21 and hits the old-order branch, the LIBERO image pins
+# gym==0.25.2 (LIBERO's own requirement -- downgrading it to 0.21 inside
+# that image was attempted and abandoned: gym 0.21's setup.py fails
+# egg_info/wheel metadata parsing against every combination of current
+# pip/setuptools/wheel tried, all for a version-specifier typo in its own
+# opencv-python requirement string) and hits the new-order branch.
+import inspect as _inspect
+_CONCATENATE_SPACE_FIRST = list(_inspect.signature(concatenate).parameters)[0] == "space"
+
+
+def _concatenate_compat(items, out, space):
+    if _CONCATENATE_SPACE_FIRST:
+        return concatenate(space, items, out)
+    return concatenate(items, out, space)
+
+
 class AsyncState(Enum):
     DEFAULT = "default"
     WAITING_RESET = "reset"
@@ -186,7 +207,25 @@ class AsyncVectorEnv(VectorEnv):
         _, successes = zip(*[pipe.recv() for pipe in self.parent_pipes])
         self._raise_if_errors(successes)
 
